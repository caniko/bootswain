# ROCKPro64 bootswain environment scaffold.

bootswain_board=pine64-rockpro64
bootswain_soc=rockchip-rk3399
bootswain_status=scaffold
bootswain_validation=not-performed
bootswain_release_stage=upstream-first
bootdelay=1
stdin=serial
stdout=serial,vidconsole
stderr=serial,vidconsole
boot_targets=mmc1 mmc0 usb0 nvme0 pxe dhcp
bootcmd=run bootswain_menu
bootswain_menu=bootmenu 30
bootswain_recovery_hint=This build is scaffolding only; use the serial console for recovery.
bootswain_installer_hint=SPI installer flow is not hardware validated yet.
