{
  "schema_version": 1,
  "board": "rock-pro64",
  "release": "2026.04-rockpro64-lab.0",
  "executor": "rockpro64-serial",
  "qemu": null,
  "scenarios": [
    {
      "name": "spi-installer-menu",
      "kind": "boot-menu",
      "target": "sd",
      "protocol": "u-boot-shell",
      "artifact": "spi-installer",
      "steps": [
        {
          "name": "boot installer menu",
          "command": "echo ROCKPro64; setenv bootswain_script_mode validation-shell; setenv devtype mmc; setenv distro_bootpart 1; mmc dev 1; mmc rescan; setenv devnum 1; if fatload mmc 1:1 ${scriptaddr} /boot.scr.uimg; then source ${scriptaddr}; else if fatload mmc 1:1 ${scriptaddr} /boot/boot.scr.uimg; then source ${scriptaddr}; else mmc dev 0; mmc rescan; setenv devnum 0; if fatload mmc 0:1 ${scriptaddr} /boot.scr.uimg; then source ${scriptaddr}; else if fatload mmc 0:1 ${scriptaddr} /boot/boot.scr.uimg; then source ${scriptaddr}; else fatls mmc 1:1 /; fatls mmc 1:1 /boot; fatls mmc 0:1 /; fatls mmc 0:1 /boot; echo \"Failed to load SPI installer script from SD\"; false; fi; fi; fi; fi",
          "expect": [
            "ROCKPro64",
            "Continue boot",
            "Rescan detected boot options",
            "Flash SPI firmware"
          ],
          "timeout_secs": 30
        }
      ]
    },
    {
      "name": "spi-install",
      "kind": "spi-install",
      "target": "spi",
      "protocol": "u-boot-shell",
      "artifact": "spi-installer",
      "steps": [
        {
          "name": "flash firmware to spi",
          "command": "run bootswain_flash_spi",
          "expect": [
            "Flashing SPI payload from",
            "SPI flash complete"
          ],
          "timeout_secs": 120
        }
      ]
    },
    {
      "name": "spi-reinstall",
      "kind": "spi-install",
      "target": "spi",
      "protocol": "u-boot-shell",
      "artifact": "spi-installer",
      "steps": [
        {
          "name": "flash firmware to spi again",
          "command": "run bootswain_flash_spi",
          "expect": [
            "Flashing SPI payload from",
            "SPI flash complete"
          ],
          "timeout_secs": 120
        }
      ]
    },
    {
      "name": "spi-erase",
      "kind": "spi-erase",
      "target": "spi",
      "protocol": "u-boot-shell",
      "artifact": "spi-installer",
      "steps": [
        {
          "name": "erase entire spi flash",
          "command": "run bootswain_erase_spi",
          "expect": [
            "SPI erase complete"
          ],
          "timeout_secs": 120
        }
      ]
    },
    {
      "name": "spi-post-install-prompt",
      "kind": "prompt",
      "target": "spi",
      "protocol": "u-boot-shell",
      "artifact": "spi-firmware",
      "steps": [
        {
          "name": "boot firmware from spi",
          "command": null,
          "expect": [
            "=> "
          ],
          "timeout_secs": 30
        }
      ]
    },
    {
      "name": "sd-uefi-boot",
      "kind": "uefi-boot",
      "target": "sd",
      "protocol": "uefi",
      "artifact": "spi-firmware",
      "steps": [
        {
          "name": "boot uefi installer from sd",
          "command": "run bootswain_boot_sd",
          "expect": [
            "Booting"
          ],
          "timeout_secs": 90
        }
      ]
    },
    {
      "name": "sd-extlinux-boot",
