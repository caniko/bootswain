            "expect": [
              "U-Boot",
              "U-Boot> "
            ],
            "timeout_secs": 120
          }
        ]
      },
      {
        "name": "family-dtb-check",
        "kind": "prompt",
        "target": "sd",
        "protocol": "u-boot-shell",
        "artifact": "sd-card-image",
        "steps": [
          {
            "name": "print board model from the firmware DTB",
            "command": "fdt addr ${fdt_addr}; fdt print / model; fdt print / compatible",
            "expect": [
              "Raspberry Pi 3 Model B Plus",
              "raspberrypi,3-model-b-plus"
            ],
            "timeout_secs": 15
          }
        ]
      },
      {
        "name": "sd-extlinux-boot",
        "kind": "extlinux-boot",
        "target": "sd",
        "protocol": "extlinux",
        "artifact": "sd-card-image",
        "steps": [
          {
            "name": "boot extlinux from sd",
            "command": "setenv boot_targets mmc; bootflow scan",
            "expect": [
              "Starting kernel"
            ],
            "timeout_secs": 60
          },
          {
            "name": "wait for login prompt",
            "command": null,
            "expect": [
              "login:"
            ],
            "timeout_secs": 240
          }
        ]
      },
      {
        "name": "usb-extlinux-boot",
        "kind": "extlinux-boot",
        "target": "usb",
        "protocol": "extlinux",
        "artifact": "sd-card-image",
        "steps": [
          {
            "name": "boot extlinux from usb",
            "command": "setenv boot_targets usb; usb start; bootflow scan",
            "expect": [
              "Starting kernel"
            ],
            "timeout_secs": 60
          },
          {
            "name": "wait for login prompt",
            "command": null,
            "expect": [
              "login:"
            ],
            "timeout_secs": 240
          }
        ]
      }
    ]
